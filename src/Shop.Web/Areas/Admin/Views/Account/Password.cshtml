@model ChangePasswordInput
@{
    ViewData["Title"] = "Change password";
}
<h1>Change password</h1>
<form method="post" class="panel form-narrow">
    <div class="field"><label asp-for="CurrentPassword">Current password</label><input asp-for="CurrentPassword" autocomplete="current-password" /><span asp-validation-for="CurrentPassword" class="field-error"></span></div>
    <div class="field"><label asp-for="NewPassword">New password</label><input asp-for="NewPassword" autocomplete="new-password" /><span asp-validation-for="NewPassword" class="field-error"></span></div>
    <div class="field"><label asp-for="ConfirmPassword">Repeat new password</label><input asp-for="ConfirmPassword" type="password" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword" class="field-error"></span></div>
    <button class="btn btn-primary" type="submit">Change password</button>
</form>
