@model List<PricingRule>
@{
    ViewData["Title"] = "Pricing";
    var rates = (List<CurrencyRate>)ViewBag.Rates;
    string baseCurrency = ViewBag.BaseCurrency;
}
<div class="page-head">
    <h1>Pricing rules</h1>
    <a class="btn btn-primary" asp-action="EditRule">New rule</a>
</div>
<p class="muted">Selling price = (supplier cost × exchange rate + supplier extra costs) × (1 + markup %) + fixed markup, then rounded up. For each product and offer, the matching rule with the highest priority wins; when priorities are equal, the most specific rule (supplier, then brand, then category) wins.</p>

<table class="table">
    <thead><tr><th>Rule</th><th>Applies to</th><th class="num">Markup</th><th class="num">Min profit</th><th>Rounding</th><th class="num">Priority</th></tr></thead>
    <tbody>
        @foreach (var r in Model)
        {
            var scope = new[] { r.Supplier?.Name, r.Brand?.Name, r.Category?.Name }.Where(x => x is not null).ToList();
            <tr class="@(r.IsActive ? null : "is-muted")">
                <td><a asp-action="EditRule" asp-route-id="@r.Id"><strong>@r.Name</strong></a></td>
                <td>@(scope.Count == 0 ? "Everything" : string.Join(" · ", scope))</td>
                <td class="num">@r.MarkupPercent.ToString("0.##")%@(r.FixedMarkup != 0 ? $" + {r.FixedMarkup:0.##}" : "")</td>
                <td class="num">@(r.MinMargin?.ToString("0.##") ?? "—")</td>
                <td>@r.Rounding</td>
                <td class="num">@r.Priority</td>
            </tr>
        }
    </tbody>
</table>
@if (Model.Count == 0)
{
    <p class="alert alert-error">No rules yet: products are sold at cost. Add a default rule with no supplier, brand or category.</p>
}

<section class="panel" id="currencies">
    <h2>Exchange rates</h2>
    <p class="muted small">How much one unit of each currency is worth in @baseCurrency. Saving a rate recalculates all prices.</p>
    <table class="table table-compact">
        <thead><tr><th>Currency</th><th class="num">1 unit = @baseCurrency</th><th>Updated</th><th></th></tr></thead>
        <tbody>
            @foreach (var r in rates)
            {
                <tr>
                    <td>@r.Code</td>
                    <td class="num">@r.RateToBase.ToString("0.######")</td>
                    <td class="small muted">@Fmt.DateTime(r.UpdatedAt)</td>
                    <td><form method="post" asp-action="DeleteRate" asp-route-code="@r.Code" data-confirm="Remove @r.Code? Offers in this currency will stop selling."><button class="link-btn" type="submit">Remove</button></form></td>
                </tr>
            }
        </tbody>
    </table>
    <form method="post" asp-action="SaveRate" class="toolbar">
        <input name="code" placeholder="CNY" maxlength="3" required style="max-width:100px" aria-label="Currency code" />
        <input name="rateToBase" type="number" step="0.000001" min="0" placeholder="0.14" required style="max-width:160px" aria-label="Rate" />
        <button class="btn" type="submit">Save rate</button>
    </form>
</section>
