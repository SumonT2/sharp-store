{
  "ConnectionStrings": {
    "Shop": "Host=localhost;Port=5432;Database=shop;Username=shop;Password=CHANGE_ME"
  },
  "Shop": {
    "Name": "My Store",
    "BaseCurrency": "USD",
    "CurrencySymbol": "$",
    "TimeZone": "UTC",
    "InStockMaxLeadDays": 3,
    "ShippingFee": 5,
    "FreeShippingOver": 100,
    "MaxQuantityPerItem": 10
  },
  "Jobs": {
    "RepriceIntervalMinutes": 10,
    "ScrapingEnabled": false,
    "ScrapeIntervalHours": 6
  },
  "Scraping": {
    "UserAgent": "ShopPriceMonitor/1.0 (+mailto:owner@example.com)",
    "TimeoutSeconds": 20,
    "MinDelaySeconds": 3,
    "RespectRobotsTxt": true
  },
  "Admin": {
    "Email": "",
    "Password": ""
  },
  "Database": {
    "AutoMigrate": true
  },
  "Seed": {
    "DemoData": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
