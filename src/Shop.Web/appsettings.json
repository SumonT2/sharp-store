{
  "ConnectionStrings": {
    "Shop": "Host=localhost;Port=5432;Database=shop;Username=shop;Password=CHANGE_ME"
  },
  "Shop": {
    "Name": "TechBhai",
    "Tagline": "Genuine gadgets, honest prices — delivered all over Bangladesh.",
    "BaseCurrency": "BDT",
    "CurrencySymbol": "৳",
    "PriceDecimals": 0,
    "NumberCulture": "en-IN",
    "TimeZone": "Asia/Dhaka",
    "InStockMaxLeadDays": 3,
    "DeliveryZones": [
      {
        "Name": "Inside Dhaka",
        "Fee": 70,
        "Days": "1–2 days"
      },
      {
        "Name": "Outside Dhaka",
        "Fee": 130,
        "Days": "2–4 days"
      }
    ],
    "FreeShippingOver": 50000,
    "MaxQuantityPerItem": 10,
    "PhonePattern": "^(?:\\+?88)?01[3-9]\\d{8}$",
    "PhoneHint": "Bangladeshi mobile number, e.g. 01712-345678",
    "Accent": "coral",
    "Hotline": "",
    "SupportHours": "10am–8pm, every day",
    "Address": ""
  },
  "Jobs": {
    "RepriceIntervalMinutes": 10,
    "ScrapingEnabled": false,
    "ScrapeIntervalHours": 6
  },
  "Scraping": {
    "UserAgent": "ShopPriceMonitor/1.0 (+mailto:owner@example.com)",
    "TimeoutSeconds": 20,
    "MinDelaySeconds": 3,
    "RespectRobotsTxt": true
  },
  "Admin": {
    "Email": "",
    "Password": ""
  },
  "Database": {
    "AutoMigrate": true
  },
  "Seed": {
    "DemoData": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
