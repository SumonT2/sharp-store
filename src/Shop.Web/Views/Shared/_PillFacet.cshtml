@model (Facet Facet, ListingUrl Url, string Key)
@{
    var selected = Model.Facet.Values.Count(v => v.Selected);
}
<details class="pill-menu" data-key="@Model.Key" data-close-outside>
    <summary class="pill @(selected > 0 ? "is-active" : null)">
        <span>@Model.Facet.Name</span>
        @if (selected > 0)
        {
            <span class="pill-count">@selected</span>
        }
        <partial name="_Icon" model='"down"' />
    </summary>
    <div class="pill-pop">
        <partial name="_FacetOptions" model="(Model.Facet, Model.Url, Model.Key, 8)" />
    </div>
</details>
