@model ProductCard
@{
    var discount = ShopFormatter.DiscountPercent(Model.Price, Model.CompareAtPrice);
}
<article class="card">
    <a class="card-media" href="/p/@Model.Slug" tabindex="-1" aria-hidden="true">
        <partial name="_ProductImage" model="(Model.ImageUrl, Model.Name)" />
        @if (discount is { } d)
        {
            <span class="ribbon">-@d%</span>
        }
    </a>
    <div class="card-body">
        @if (Model.Brand is not null)
        {
            <div class="card-brand">@Model.Brand</div>
        }
        <h3 class="card-title"><a href="/p/@Model.Slug">@Model.Name</a></h3>
        @if (Model.Highlights.Count > 0)
        {
            <ul class="card-specs">
                @foreach (var h in Model.Highlights.Take(4))
                {
                    <li>@h</li>
                }
            </ul>
        }
        <div class="card-foot">
            <div class="price">
                <span class="price-now">@Fmt.Money(Model.Price)</span>
                @if (discount is not null)
                {
                    <s class="price-was">@Fmt.Money(Model.CompareAtPrice)</s>
                }
            </div>
            <span class="badge @ShopFormatter.AvailabilityClass(Model.Availability)">@Fmt.AvailabilityText(Model.Availability, Model.LeadTimeDays)</span>
        </div>
        @if (Model.Availability == Availability.PreOrder && Model.OfferEndsAt is { } ends)
        {
            <div class="card-offer"><partial name="_Icon" model='"clock"' /><span>Deal price · <time data-countdown="@ShopFormatter.Iso(ends)" datetime="@ShopFormatter.Iso(ends)">@Fmt.DateTime(ends)</time></span></div>
        }
    </div>
</article>
