@inject CartCookie Cart
@inject CategoryMenu Menu
@inject OrderService Orders
@{
    var categories = await Menu.GetAsync();
    // The category bar lists the most specific categories (sub-categories, or a top category without any).
    var leaves = categories.SelectMany(c => c.Children.Count > 0 ? c.Children : [c]).ToList();
    var cartLines = Cart.Read();
    var cartCount = cartLines.Sum(l => l.Quantity);
    var cartTotal = cartCount > 0 ? (await Orders.BuildCartAsync(cartLines)).Subtotal : 0m;
    var shop = Fmt.Shop;
    var shopName = shop.Name;
    var title = ViewData["Title"] as string;
    var path = Context.Request.Path.Value ?? "/";
    var query = Context.Request.QueryString.Value ?? "";
    var zones = shop.EffectiveDeliveryZones;
    var hotline = string.IsNullOrWhiteSpace(shop.Hotline) ? null : shop.Hotline.Trim();
    var tel = hotline is null ? null : "tel:" + new string(hotline.Where(c => char.IsDigit(c) || c == '+').ToArray());
    var isDeals = path == "/products" && query.Contains("avail=pre-order");
    string? Current(bool on) => on ? "is-active" : null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(string.IsNullOrEmpty(title) ? $"{shopName} — keyboards, mice & accessories" : $"{title} · {shopName}")</title>
    @if (ViewData["Description"] is string description)
    {
        <meta name="description" content="@description" />
    }
    <meta name="theme-color" content="#f4f5f7" />
    <partial name="_DisplayPrefs" />
    <link rel="preload" href="~/fonts/manrope.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="~/fonts/space-grotesk.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%23dbe8f8'/%3E%3Crect x='7' y='6' width='18' height='14' rx='4' fill='%232f7fd6'/%3E%3Crect x='7' y='24' width='18' height='3' rx='1.5' fill='%2397bfee'/%3E%3C/svg%3E" />
</head>
<body>
    <a class="skip-link" href="#main">Skip to content</a>

    <div class="topbar">
        <div class="container topbar-row">
            <span class="topbar-full">
                @if (hotline is not null)
                {
                    <a href="@tel">Hotline @hotline@(string.IsNullOrWhiteSpace(shop.SupportHours) ? "" : $" · {shop.SupportHours}")</a>
                }
                else
                {
                    <span>@shop.Tagline</span>
                }
            </span>
            <span class="topbar-full">
                <span>@string.Join(" · ", zones.Select(z => $"{z.Name} {Fmt.Money(z.Fee)}"))</span>
                <span>Cash on delivery all over Bangladesh</span>
                @if (shop.FreeShippingOver is { } free)
                {
                    <span>Free delivery over @Fmt.Money(free)</span>
                }
            </span>
            <span class="topbar-short">Cash on delivery · @string.Join(" · ", zones.Select(z => $"{z.Name.Replace("Inside ", "")} {Fmt.Money(z.Fee)}"))</span>
        </div>
    </div>

    <header class="site-header">
        <div class="container header-row">
            <a class="logo" href="/" aria-label="@shopName home">
                <span class="logo-mark" aria-hidden="true"></span>
                <span class="logo-text">@shopName</span>
            </a>

            <form class="search" action="/search" method="get" role="search">
                <partial name="_Icon" model='"search"' />
                <input type="search" name="q" placeholder="Search keyboards, mice, switches…" aria-label="Search products" value="@Context.Request.Query["q"]" />
                <button type="submit">Search</button>
            </form>

            <div class="header-tools">
                @if (tel is not null)
                {
                    <a class="icon-btn call-link" href="@tel" aria-label="Call @hotline"><partial name="_Icon" model='"phone"' /></a>
                }
                <partial name="_DisplaySettings" />
                <a class="cart-link" href="/cart" aria-label="Cart, @cartCount item@(cartCount == 1 ? "" : "s"), @Fmt.Money(cartTotal)">
                    <partial name="_Icon" model='"cart"' />
                    <span class="cart-text">
                        <small>Cart · @cartCount item@(cartCount == 1 ? "" : "s")</small>
                        <strong>@Fmt.Money(cartTotal)</strong>
                    </span>
                </a>
            </div>
        </div>
    </header>

    <nav class="catnav" aria-label="Categories">
        <div class="container catnav-row">
            <details class="mega" data-close-outside>
                <summary>All categories <partial name="_Icon" model='"down"' /></summary>
                <div class="mega-panel">
                    <a class="mega-all" href="/products"><partial name="_Icon" model='"grid"' /> All products</a>
                    <div class="mega-cols">
                        @foreach (var c in categories)
                        {
                            <div>
                                <a class="mega-head" href="/c/@c.Slug">@c.Name</a>
                                @foreach (var child in c.Children)
                                {
                                    <a href="/c/@child.Slug">@child.Name</a>
                                }
                            </div>
                        }
                    </div>
                </div>
            </details>
            @foreach (var c in leaves)
            {
                <a class="@Current(path.StartsWith("/c/" + c.Slug))" href="/c/@c.Slug">@c.Name</a>
            }
            <a class="nav-deal @Current(isDeals)" href="/products?avail=pre-order">Pre-order deals</a>
        </div>
    </nav>

    @if (TempData["Flash"] is string flash)
    {
        <div class="container"><div class="flash" role="status"><partial name="_Icon" model='"check"' /> @flash</div></div>
    }

    <main id="main" class="container main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container footer-grid">
            <div class="footer-brand">
                <a class="logo" href="/"><span class="logo-mark" aria-hidden="true"></span><span class="logo-text">@shopName</span></a>
                <p>@shop.Tagline</p>
            </div>
            <div>
                <h3>Shop</h3>
                <ul>
                    @foreach (var c in leaves.Take(5))
                    {
                        <li><a href="/c/@c.Slug">@c.Name</a></li>
                    }
                    <li><a href="/products?avail=pre-order">Pre-order deals</a></li>
                </ul>
            </div>
            <div>
                <h3>Delivery</h3>
                <ul>
                    @foreach (var z in zones)
                    {
                        <li>@z.Name @Fmt.Money(z.Fee)@(z.Days is null ? "" : $" · {z.Days}")</li>
                    }
                    @if (shop.FreeShippingOver is { } freeOver)
                    {
                        <li>Free over @Fmt.Money(freeOver)</li>
                    }
                    <li>Cash on delivery</li>
                </ul>
            </div>
            <div>
                <h3>Contact</h3>
                <ul>
                    @if (hotline is not null)
                    {
                        <li><a href="@tel">Hotline @hotline</a></li>
                    }
                    @if (!string.IsNullOrWhiteSpace(shop.Address))
                    {
                        <li>@shop.Address</li>
                    }
                    @if (!string.IsNullOrWhiteSpace(shop.SupportHours))
                    {
                        <li>@shop.SupportHours</li>
                    }
                    <li>Pre-order prices hold until the offer window shown on the product closes.</li>
                </ul>
            </div>
        </div>
        <div class="container footer-bottom">© @DateTime.UtcNow.Year @shopName</div>
    </footer>

    <nav class="appbar" aria-label="Shortcuts">
        <a class="@Current(path == "/")" href="/"><partial name="_Icon" model='"home"' />Home</a>
        <a class="@Current(path == "/products" && !isDeals || path.StartsWith("/c/"))" href="/products"><partial name="_Icon" model='"grid"' />Categories</a>
        <a class="@Current(isDeals)" href="/products?avail=pre-order"><partial name="_Icon" model='"clock"' />Deals</a>
        <a class="@Current(path.StartsWith("/cart") || path.StartsWith("/checkout"))" href="/cart"><partial name="_Icon" model='"cart"' />Cart · @cartCount</a>
    </nav>
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
