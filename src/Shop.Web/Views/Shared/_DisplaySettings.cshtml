<details class="settings" data-close-outside>
    <summary class="icon-btn" aria-label="Display settings" title="Display settings"><partial name="_Icon" model='"display"' /></summary>
    <div class="settings-pop">
        <p class="settings-title">Display</p>
        <fieldset class="seg">
            <legend>Layout</legend>
            <div class="seg-options">
                <label><input type="radio" name="pref-density" value="comfortable" data-pref="density" checked /> Comfortable</label>
                <label><input type="radio" name="pref-density" value="compact" data-pref="density" /> Compact</label>
            </div>
        </fieldset>
        <fieldset class="seg">
            <legend>Theme</legend>
            <div class="seg-options">
                <label><input type="radio" name="pref-theme" value="system" data-pref="theme" checked /> System</label>
                <label><input type="radio" name="pref-theme" value="light" data-pref="theme" /> Light</label>
                <label><input type="radio" name="pref-theme" value="dark" data-pref="theme" /> Dark</label>
            </div>
        </fieldset>
    </div>
</details>
