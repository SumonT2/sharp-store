@model HomeViewModel
@{
    ViewData["Title"] = "";
    ViewData["Description"] = $"{Fmt.Shop.Name}: mechanical keyboards, mice and accessories in Bangladesh with detailed specifications and cash on delivery.";
}

<section class="hero">
    <div class="hero-text">
        <p class="eyebrow">Genuine gadgets · Honest prices · All over Bangladesh</p>
        <h1>Find your perfect keyboard and mouse.</h1>
        <p class="lead">Filter by what matters to you — switch type, layout, wireless, DPI, weight — and order from stock, or pre-order at a special price.</p>
        <div class="hero-actions">
            <a class="btn btn-primary" href="/products">Browse all products</a>
            <a class="btn btn-ghost" href="/products?avail=pre-order">See pre-order deals</a>
        </div>
    </div>
    <ul class="hero-points">
        <li><partial name="_Icon" model='"check"' /><div><strong>In-stock items</strong><span>Inside Dhaka 1–2 days, outside Dhaka 2–4 days</span></div></li>
        <li><partial name="_Icon" model='"clock"' /><div><strong>Pre-order deals</strong><span>Lower prices for a limited time</span></div></li>
        <li><partial name="_Icon" model='"shield"' /><div><strong>Cash on delivery</strong><span>Check your product, then pay</span></div></li>
    </ul>
</section>

@if (Model.Categories.Count > 0)
{
    <section class="section">
        <h2 class="section-title">Shop by category</h2>
        <div class="category-tiles">
            @foreach (var c in Model.Categories)
            {
                <a class="category-tile" href="/c/@c.Slug">
                    <strong>@c.Name</strong>
                    @if (c.Children.Count > 0)
                    {
                        <span>@string.Join(" · ", c.Children.Take(3).Select(x => x.Name))</span>
                    }
                </a>
            }
        </div>
    </section>
}

@if (Model.PreOrderDeals.Count > 0)
{
    <section class="section">
        <div class="section-head">
            <h2 class="section-title">Pre-order deals <span class="pill pill-pre">Limited time</span></h2>
            <a href="/products?avail=pre-order" class="link-more">View all <partial name="_Icon" model='"chevron"' /></a>
        </div>
        <div class="grid">
            @foreach (var p in Model.PreOrderDeals)
            {
                <partial name="_ProductCard" model="p" />
            }
        </div>
    </section>
}

@if (Model.Featured.Count > 0)
{
    <section class="section">
        <div class="section-head">
            <h2 class="section-title">In stock now</h2>
            <a href="/products?avail=in-stock" class="link-more">View all <partial name="_Icon" model='"chevron"' /></a>
        </div>
        <div class="grid">
            @foreach (var p in Model.Featured)
            {
                <partial name="_ProductCard" model="p" />
            }
        </div>
    </section>
}

@if (Model.Featured.Count == 0 && Model.PreOrderDeals.Count == 0)
{
    <div class="empty">
        <h2>No products yet</h2>
        <p>Sign in to the <a href="/admin">admin</a> and import a catalog CSV to get started.</p>
    </div>
}
