@model ListingViewModel
@{
    var r = Model.Result;
    var url = Model.Url;
    var currentSort = url.First("sort") ?? "featured";

    // Active filter chips: (label, link that removes it)
    var chips = new List<(string Label, string Href)>();
    foreach (var v in r.AvailabilityFacet.Values.Where(v => v.Selected)) chips.Add((v.Label, url.Toggle("avail", v.Value)));
    foreach (var v in r.BrandFacet.Values.Where(v => v.Selected)) chips.Add((v.Label, url.Toggle("brand", v.Value)));
    foreach (var f in r.SpecFacets)
        foreach (var v in f.Values.Where(v => v.Selected)) chips.Add(($"{f.Name}: {v.Label}", url.Toggle(ListingUrl.SpecKey(f.Key), v.Value)));
    var query = url.ToQuery(null);
    if (query.MinPrice is not null || query.MaxPrice is not null)
        chips.Add(($"{(query.MinPrice is { } mn ? Fmt.Money(mn) : "Any")} – {(query.MaxPrice is { } mx ? Fmt.Money(mx) : "any")}", url.Without("min", "max")));
    var shownFrom = r.Total == 0 ? 0 : (r.Page - 1) * r.PageSize + 1;
    var shownTo = Math.Min(r.Total, r.Page * r.PageSize);
}

<div class="listing-head">
    <h1>@Model.Title</h1>
    <p class="muted" data-listing-count>@r.Total product@(r.Total == 1 ? "" : "s")</p>
</div>

@if (r.Subcategories.Count > 0)
{
    <div class="subcategories">
        @foreach (var c in r.Subcategories)
        {
            <a class="chip" href="/c/@c.Slug">@c.Name</a>
        }
    </div>
}

<div class="listing">
    <aside id="filters" class="filters" aria-label="Filters">
        <div class="filters-head">
            <strong>Filters</strong>
            @if (url.HasFilters)
            {
                <a class="link-btn" href="@url.ClearFilters()" data-ajax>Clear all</a>
            }
            <button type="button" class="icon-btn" data-toggle-filters aria-label="Close filters"><partial name="_Icon" model='"x"' /></button>
        </div>
        <div class="filters-body">
            <details class="facet" open>
                <summary>Price (@Fmt.Shop.CurrencySymbol)</summary>
                <partial name="_PriceForm" model="(r, url)" view-data='new ViewDataDictionary(ViewData) { ["PriceFormId"] = "side" }' />
            </details>
            @foreach (var f in r.SpecFacets)
            {
                <partial name="_Facet" model="(f, url, ListingUrl.SpecKey(f.Key))" />
            }
            @if (r.BrandFacet.Values.Count > 0)
            {
                <partial name="_Facet" model='(r.BrandFacet, url, "brand")' />
            }
            @if (r.AvailabilityFacet.Values.Count > 0)
            {
                <partial name="_Facet" model='(r.AvailabilityFacet, url, "avail")' />
            }
        </div>
        <div class="filters-foot">
            <a class="btn btn-ghost" href="@url.ClearFilters()" data-ajax>Clear all</a>
            <button type="button" class="btn btn-dark" data-toggle-filters>Show @r.Total result@(r.Total == 1 ? "" : "s")</button>
        </div>
    </aside>

    <section class="results" aria-label="Products">
        <div class="toolbar-row">
            <div class="active-filters">
                <button type="button" class="chip filters-btn" data-toggle-filters aria-controls="filters" aria-expanded="false">
                    <partial name="_Icon" model='"sliders"' /> Filters@(chips.Count > 0 ? $" · {chips.Count}" : "")
                </button>
                @foreach (var (label, href) in chips)
                {
                    <a class="chip chip-active" href="@href" data-ajax aria-label="Remove filter @label">@label <partial name="_Icon" model='"x"' /></a>
                }
                @if (r.Total > 0)
                {
                    <span class="result-count">Showing @shownFrom–@shownTo of @r.Total</span>
                }
            </div>
            <form method="get" class="sort-form" data-ajax>
                @foreach (var h in url.HiddenFields("sort"))
                {
                    <input type="hidden" name="@h.Key" value="@h.Value" />
                }
                <span aria-hidden="true">Sort</span>
                <label for="sort" class="sr-only">Sort by</label>
                <select id="sort" name="sort" data-autosubmit>
                    @foreach (var (slug, label) in ListingUrl.SortOptions)
                    {
                        <option value="@slug" selected="@(slug == currentSort)">@label</option>
                    }
                </select>
                <noscript><button class="btn btn-small" type="submit">Apply</button></noscript>
            </form>
        </div>

        @if (r.Products.Count == 0)
        {
            <div class="empty">
                <h2>No products match</h2>
                <p>Try removing a filter@(url.HasFilters ? "" : " or searching for something else").</p>
                @if (url.HasFilters)
                {
                    <a class="btn btn-dark" href="@url.ClearFilters()" data-ajax>Clear filters</a>
                }
            </div>
        }
        else
        {
            <div class="grid">
                @foreach (var p in r.Products)
                {
                    <partial name="_ProductCard" model="p" />
                }
            </div>
        }

        @if (r.PageCount > 1)
        {
            <nav class="pagination" aria-label="Pages">
                @if (r.Page > 1)
                {
                    <a href="@url.With("page", (r.Page - 1).ToString())" rel="prev" data-ajax="page">← Previous</a>
                }
                @for (var i = Math.Max(1, r.Page - 2); i <= Math.Min(r.PageCount, r.Page + 2); i++)
                {
                    if (i == r.Page)
                    {
                        <span aria-current="page">@i</span>
                    }
                    else
                    {
                        <a href="@url.With("page", i.ToString())" data-ajax="page">@i</a>
                    }
                }
                @if (r.Page < r.PageCount)
                {
                    <a href="@url.With("page", (r.Page + 1).ToString())" rel="next" data-ajax="page">Next →</a>
                }
            </nav>
        }
    </section>
</div>
