@model ProductOption
@{
    var p = Model.Product;
    var qtyId = $"qty-{p.Id}";
    var isPre = p.Availability == Availability.PreOrder;
}
<div class="buy-box">
    @if (isPre && p.OfferEndsAt is { } ends)
    {
        <div class="offer-timer">
            <partial name="_Icon" model='"clock"' />
            <span>Pre-order price valid until <strong>@Fmt.DateTime(ends)</strong> · <time data-countdown="@ShopFormatter.Iso(ends)" datetime="@ShopFormatter.Iso(ends)"></time></span>
        </div>
    }
    @if (p.IsPurchasable)
    {
        <form method="post" asp-antiforgery="true" action="/cart/add" class="add-form">
            <input type="hidden" name="productId" value="@p.Id" />
            <label for="@qtyId" class="sr-only">Quantity</label>
            <div class="qty">
                <button type="button" data-qty="-1" aria-label="Decrease quantity">−</button>
                <input id="@qtyId" type="number" name="quantity" value="1" min="1" max="@Model.MaxQuantity" inputmode="numeric" />
                <button type="button" data-qty="1" aria-label="Increase quantity">+</button>
            </div>
            <button type="submit" class="btn btn-primary">
                <partial name="_Icon" model='"cart"' /> @(isPre ? "Pre-order" : "Add to cart")
            </button>
            <button type="submit" name="buyNow" value="true" class="btn btn-accent">Buy now</button>
        </form>
    }
</div>
