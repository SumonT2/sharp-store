@model ListingViewModel
@{
    ViewData["Title"] = Model.Title;
    ViewData["Description"] = Model.Result.Category?.Description ?? $"{Model.Title} — compare specifications and prices.";
}

<nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a>
    @foreach (var c in Model.Result.Breadcrumb)
    {
        <span aria-hidden="true">/</span>
        @if (c == Model.Result.Category)
        {
            <span aria-current="page">@c.Name</span>
        }
        else
        {
            <a href="/c/@c.Slug">@c.Name</a>
        }
    }
</nav>

@* Everything inside #listing-root is replaced in place when a filter changes (see site.js). *@
<p id="listing-status" class="sr-only" aria-live="polite"></p>
<div id="listing-root">
    <partial name="_ListingBody" model="Model" />
</div>
