@using System.Text.Json
@model ProductViewModel
@{
    var main = Model.Product;
    var selected = Model.Selected;
    ViewData["Title"] = main.Name;
    ViewData["Description"] = main.ShortDescription ?? main.Name;
    var paragraphs = (main.Description ?? "").Split(["\r\n\r\n", "\n\n"], StringSplitOptions.RemoveEmptyEntries);

    string? ImageFor(Product p) => string.IsNullOrWhiteSpace(p.ImageUrl) ? main.ImageUrl : p.ImageUrl;
    var imagesDiffer = Model.Options.Select(o => ImageFor(o.Product)).Distinct().Count() > 1;
    // Values per option id, for specs that differ between options (the page script swaps them).
    string? Values(SpecRow row) => row.Varies ? JsonSerializer.Serialize(Model.Options.ToDictionary(o => o.Product.Id.ToString(), o => row.ValueFor(o.Product.Id))) : null;
    var keySpecs = Model.SpecGroups.SelectMany(g => g.Rows).Where(r => r.ShowOnCard).Take(4).ToList();
}

<nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a>
    @foreach (var c in Model.Breadcrumb)
    {
        <span aria-hidden="true">/</span>
        <a href="/c/@c.Slug">@c.Name</a>
    }
</nav>

<div class="product" data-product-page>
    <div class="product-gallery">
        @if (imagesDiffer)
        {
            @foreach (var o in Model.Options)
            {
                <div class="product-media" data-option-panel="@o.Product.Id" hidden="@(o != selected)">
                    <partial name="_ProductImage" model="(ImageFor(o.Product), o.Product.Name)" />
                </div>
            }
        }
        else
        {
            <div class="product-media"><partial name="_ProductImage" model="(main.ImageUrl, main.Name)" /></div>
        }
    </div>

    <div class="product-info">
        @if (main.Brand is not null)
        {
            <a class="product-brand" href="/products?brand=@main.Brand.Slug">@main.Brand.Name</a>
        }
        <h1>@main.Name</h1>
        <p class="muted small">SKU: <span data-option-sku>@selected.Product.Sku</span></p>
        @if (!string.IsNullOrWhiteSpace(main.ShortDescription))
        {
            <p class="lead">@main.ShortDescription</p>
        }

        @if (Model.HasChoice)
        {
            <div class="variant-picker">
                <p class="variant-title">Option: <strong data-option-label>@selected.Label</strong></p>
                <div class="variant-options" role="radiogroup" aria-label="Choose an option">
                    @foreach (var o in Model.Options)
                    {
                        var isSelected = o == selected;
                        <a class="variant-option @(isSelected ? "is-selected" : null) @(o.Product.IsPurchasable ? null : "is-unavailable")"
                           href="?v=@Uri.EscapeDataString(o.Product.Sku)" role="radio" aria-checked="@(isSelected ? "true" : "false")"
                           data-option="@o.Product.Id" data-sku="@o.Product.Sku" data-label="@o.Label">
                            <span class="variant-name">@o.Label</span>
                            <span class="variant-meta">@(o.Product.IsPurchasable ? Fmt.Money(o.Product.Price) : "Out of stock")</span>
                        </a>
                    }
                </div>
            </div>
        }

        @foreach (var o in Model.Options)
        {
            <div data-option-panel="@o.Product.Id" hidden="@(o != selected)">
                <partial name="_BuyBox" model="o" />
            </div>
        }

        @if (keySpecs.Count > 0)
        {
            <ul class="key-specs">
                @foreach (var row in keySpecs)
                {
                    <li><span>@row.Name</span><strong data-spec-values="@Values(row)">@row.ValueFor(selected.Product.Id)</strong></li>
                }
            </ul>
        }
    </div>
</div>

<div class="product-details">
    @if (Model.SpecGroups.Count > 0)
    {
        <section class="specs" id="specifications">
            <h2>Specifications</h2>
            @foreach (var g in Model.SpecGroups)
            {
                <table class="spec-table">
                    <caption>@g.Name</caption>
                    <tbody>
                        @foreach (var row in g.Rows)
                        {
                            <tr>
                                <th scope="row">@row.Name</th>
                                <td data-spec-values="@Values(row)">@row.ValueFor(selected.Product.Id)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </section>
    }

    @if (paragraphs.Length > 0)
    {
        <section class="description">
            <h2>Description</h2>
            @foreach (var para in paragraphs)
            {
                <p>@para</p>
            }
        </section>
    }
</div>

@if (Model.Related.Count > 0)
{
    <section class="section">
        <h2 class="section-title">You may also like</h2>
        <div class="grid">
            @foreach (var c in Model.Related)
            {
                <partial name="_ProductCard" model="c" />
            }
        </div>
    </section>
}
