@model CheckoutViewModel
@{
    ViewData["Title"] = "Checkout";
    var zones = Fmt.Shop.EffectiveDeliveryZones;
    var selected = OrderService.FindZone(Model.Input.DeliveryZone, Fmt.Shop);
    var fee = OrderService.ShippingFor(Model.Cart.Subtotal, selected?.Fee ?? zones.Min(z => z.Fee), Fmt.Shop);
    string FeeText(decimal f) => f == 0 ? "Free" : Fmt.Money(f);
}

<h1>Checkout</h1>

@if (Model.Error is not null)
{
    <div class="alert alert-error" role="alert">@Model.Error</div>
}

<div class="cart">
    <form method="post" asp-antiforgery="true" action="/checkout" class="checkout-form" novalidate>
        <div asp-validation-summary="ModelOnly" class="alert alert-error"></div>
        <fieldset>
            <legend>Delivery details</legend>
            <div class="field">
                <label asp-for="Input.CustomerName">Full name</label>
                <input asp-for="Input.CustomerName" autocomplete="name" required />
                <span asp-validation-for="Input.CustomerName" class="field-error"></span>
            </div>
            <div class="field-row">
                <div class="field">
                    <label asp-for="Input.Phone">Mobile number</label>
                    <input asp-for="Input.Phone" type="tel" autocomplete="tel" inputmode="tel" placeholder="01XXXXXXXXX" required />
                    <span class="hint">@Fmt.Shop.PhoneHint</span>
                    <span asp-validation-for="Input.Phone" class="field-error"></span>
                </div>
                <div class="field">
                    <label asp-for="Input.Email">Email <span class="muted">(optional)</span></label>
                    <input asp-for="Input.Email" type="email" autocomplete="email" />
                    <span asp-validation-for="Input.Email" class="field-error"></span>
                </div>
            </div>
            <div class="field">
                <label asp-for="Input.Address">Address</label>
                <textarea asp-for="Input.Address" rows="2" autocomplete="street-address" required></textarea>
                <span asp-validation-for="Input.Address" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="Input.City">City / District</label>
                <input asp-for="Input.City" autocomplete="address-level2" required />
                <span asp-validation-for="Input.City" class="field-error"></span>
            </div>
            <div class="field">
                <span class="label">Delivery area</span>
                <div class="zone-options">
                    @foreach (var z in zones)
                    {
                        var zoneFee = OrderService.ShippingFor(Model.Cart.Subtotal, z.Fee, Fmt.Shop);
                        <label class="radio-card zone-option">
                            <input type="radio" name="Input.DeliveryZone" value="@z.Name" checked="@(selected?.Name == z.Name)" required
                                   data-fee-text="@FeeText(zoneFee)" data-total-text="@Fmt.Money(Model.Cart.Subtotal + zoneFee)" />
                            <span><strong>@z.Name</strong><span class="muted small">@FeeText(zoneFee)@(z.Days is null ? "" : $" · {z.Days}")</span></span>
                        </label>
                    }
                </div>
                <span asp-validation-for="Input.DeliveryZone" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="Input.Notes">Order notes <span class="muted">(optional)</span></label>
                <textarea asp-for="Input.Notes" rows="2"></textarea>
            </div>
        </fieldset>
        <fieldset>
            <legend>Payment</legend>
            <label class="radio-card">
                <input type="radio" name="payment" value="cod" checked />
                <span><strong>Cash on delivery</strong><span class="muted small">Pay when your order arrives.</span></span>
            </label>
        </fieldset>
        <button type="submit" class="btn btn-primary btn-lg btn-block">Place order · <span data-order-total>@Fmt.Money(Model.Cart.Subtotal + fee)</span></button>
    </form>

    <aside class="summary">
        <h2>Your order</h2>
        <ul class="summary-items">
            @foreach (var item in Model.Cart.Items)
            {
                <li>
                    <span>@item.Quantity × @item.Name
                        @if (item.Availability == Availability.PreOrder)
                        {
                            <span class="badge badge-pre">Pre-order ~@item.LeadTimeDays days</span>
                        }
                    </span>
                    <span>@Fmt.Money(item.LineTotal)</span>
                </li>
            }
        </ul>
        <dl>
            <dt>Subtotal</dt><dd>@Fmt.Money(Model.Cart.Subtotal)</dd>
            <dt>Delivery</dt><dd data-delivery-fee>@(selected is null && fee > 0 ? "from " : "")@FeeText(fee)</dd>
            <dt class="total">Total</dt><dd class="total" data-order-total>@Fmt.Money(Model.Cart.Subtotal + fee)</dd>
        </dl>
        @if (Model.Cart.Items.Any(i => i.Availability == Availability.PreOrder))
        {
            <p class="small muted">Pre-order items ship separately when they arrive. The pre-order price is locked in when you place the order.</p>
        }
    </aside>
</div>
